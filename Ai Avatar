rt sys\nimport math\nimport time\nimport asyncio\nimport cv2\nimport numpy as np\nimport librosa\nimport queue as pyqueue\n\nfrom livekit import rtc\nfrom livekit.api import AccessToken, VideoGrants\nimport stream_pipeline_online as spo\n\nLIVEKIT_URL = os.getenv(\"LIVEKIT_URL\", \"wss://app-913t6q6z.livekit.cloud\")\nLIVEKIT_API_KEY = os.getenv(\"LIVEKIT_API_KEY\", \"APIP3dS4rkpBpDJ\")\nLIVEKIT_API_SECRET = os.getenv(\"LIVEKIT_API_SECRET\", \"5Cfk8o9xzeQpQqZF7yIyLjJTI2aDqexNgVXuuSjbEgxB\")\n\nROOM_NAME = \"avatar\"\nPARTICIPANT_NAME = \"Ditto-Avatar\"\n\n\nclass WriterTap:\n    def __init__(self, original_writer, frame_queue):\n        self.original_writer = original_writer\n        self.frame_queue = frame_queue\n\n    def __call__(self, frame_rgb, fmt=\"rgb\"):\n        self.frame_queue.put(frame_rgb.copy())\n        return self.original_writer(frame_rgb, fmt=fmt)\n\n    def close(self):\n        return self.original_writer.close()\n\n\nasync def play_audio_realtime(audio_source, audio, sample_rate, start_event):\n    \"\"\"Plays the driving .wav at true wall-clock pace, independent of how\n    fast (or slow) video generation happens to be running. Waits for\n    start_event so audio doesn't get a head start over video's priming\n    delay -- NOTE: if video RTF > 1 *after* starting, the picture will\n    still drift behind this audio over time; that only fully resolves\n    once RTF <= 1 throughout.\"\"\"\n    await start_event.wait()\n    frame_ms = 20\n    samples_per_frame = int(sample_rate * frame_ms / 1000)\n    audio_i16 = (np.clip(audio, -1.0, 1.0) * 32767).astype(np.int16)\n\n    i = 0\n    while i < len(audio_i16):\n        chunk = audio_i16[i:i + samples_per_frame]\n        if len(chunk) < samples_per_frame:\n            chunk = np.pad(chunk, (0, samples_per_frame - len(chunk)))\n        frame = rtc.AudioFrame.create(sample_rate, 1, samples_per_frame)\n        np.copyto(np.frombuffer(frame.data, dtype=np.int16), chunk)\n        await audio_source.capture_frame(frame)\n        await asyncio.sleep(frame_ms / 1000)\n        i += samples_per_frame\n\n\nasync def publish_ditto_stream():\n    print(\"Initializing StreamSDK (online)...\")\n    cfg_pkl = \"./checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch_dualgpu.pkl\"  # or the single-GPU pkl\n    data_root = \"./checkpoints/ditto_pytorch\"\n    output_video_path = \"/kaggle/working/live_capture_debug.mp4\"\n    source_image = \"./example/image.png\"\n    driven_audio = \"./example/audio.wav\"\n\n    sdk = spo.StreamSDK(cfg_pkl, data_root)\n    print(\"Setting up source avatar image (online_mode=True, sampling_timesteps=10, max_size=512)...\")\n    sdk.setup(\n        source_image,\n        output_video_path,\n        online_mode=True,\n        sampling_timesteps=10,\n        max_size=512,\n    )\n\n    frame_queue = pyqueue.Queue()\n    sdk.writer = WriterTap(sdk.writer, frame_queue)\n    first_frame_event = asyncio.Event()   # signals audio to start once video actually begins\n\n    print(f\"Connecting to LiveKit room: {ROOM_NAME}...\")\n    room = rtc.Room()\n    token = (\n        AccessToken(LIVEKIT_API_KEY, LIVEKIT_API_SECRET)\n        .with_identity(PARTICIPANT_NAME)\n        .with_name(\"Ditto Avatar Bot\")\n        .with_grants(VideoGrants(room_join=True, room=ROOM_NAME))\n        .to_jwt()\n    )\n    await room.connect(LIVEKIT_URL, token)\n    print(\"Connected to LiveKit!\")\n\n    fps = 25\n    frame_duration = 1.0 / fps\n    video_source = None\n    video_track = None\n\n    print(\"Loading audio waveform with librosa...\")\n    audio, sr = librosa.load(driven_audio, sr=16000)\n\n    # --- publish the audio track up front, alongside the video track ---\n    # queue_size_ms gives a little slack to absorb minor scheduling jitter\n    audio_source = rtc.AudioSource(sample_rate=sr, num_channels=1, queue_size_ms=200)\n    audio_track = rtc.LocalAudioTrack.create_audio_track(\"avatar_audio\", audio_source)\n    audio_options = rtc.TrackPublishOptions(source=rtc.TrackSource.SOURCE_MICROPHONE)\n    await room.local_participant.publish_track(audio_track, audio_options)\n    print(\"Audio track published.\")\n\n    async def drain_and_publish():\n        nonlocal video_source, video_track\n        while True:\n            try:\n                frame = frame_queue.get_nowait()\n            except pyqueue.Empty:\n                break\n            h, w, c = frame.shape\n            if video_source is None:\n                print(f\"Initializing LiveKit VideoSource with model resolution: {w}x{h}\")\n                video_source = rtc.VideoSource(w, h)\n                video_track = rtc.LocalVideoTrack.create_video_track(\"avatar_video\", video_source)\n                video_options = rtc.TrackPublishOptions(\n                    source=rtc.TrackSource.SOURCE_CAMERA,\n                    video_encoding=rtc.VideoEncoding(max_framerate=fps, max_bitrate=2_000_000),\n                )\n                await room.local_participant.publish_track(video_track, video_options)\n                print(\"Video track published! Stream is now LIVE.\")\n                first_frame_event.set()   # video is actually flowing now -- start the audio clock\n            rgba_frame = np.ascontiguousarray(cv2.cvtColor(frame, cv2.COLOR_RGB2RGBA))\n            frame_buffer = rtc.VideoFrame(width=w, height=h, type=rtc.VideoBufferType.RGBA, data=rgba_frame.tobytes())\n            video_source.capture_frame(frame_buffer)\n            await asyncio.sleep(frame_duration)\n\n    num_f = math.ceil(len(audio) / 16000 * 25)\n    sdk.setup_Nd(N_d=num_f)\n\n    chunksize = (3, 5, 2)\n    split_len = int(sum(chunksize) * 0.04 * 16000) + 80\n    step = chunksize[1] * 640\n    audio_padded = np.concatenate([np.zeros((chunksize[0] * 640,), dtype=np.float32), audio], 0)\n\n    async def feed_video():\n        # single pass -- matches play_audio_realtime() so both tasks finish\n        # together instead of video looping forever after audio goes quiet\n        print(\"--- Starting video pass ---\")\n        t0 = time.time()\n        n_chunks = 0\n        for i in range(0, len(audio_padded), step):\n            audio_chunk = audio_padded[i:i + split_len]\n            if len(audio_chunk) < split_len:\n                audio_chunk = np.pad(audio_chunk, (0, split_len - len(audio_chunk)))\n            # run in a thread so this blocking GPU/CPU call can't freeze\n            # the event loop and starve the concurrent audio task\n            await asyncio.to_thread(sdk.run_chunk, audio_chunk, chunksize)\n            await drain_and_publish()\n\n            n_chunks += 1\n            if n_chunks % 10 == 0:\n                elapsed = time.time() - t0\n                audio_seconds_fed = i / 16000\n                if audio_seconds_fed > 0:\n                    rtf = elapsed / audio_seconds_fed\n                    print(f\"  running RTF: {rtf:.2f}  ({'ahead of' if rtf < 1 else 'behind'} realtime)\")\n        print(\"Video pass complete.\")\n\n    try:\n        # audio plays on its own real-time clock; video generates as fast as it can.\n        # gather() returns once BOTH finish, so the stream now ends on its own.\n        await asyncio.gather(\n            feed_video(),\n            play_audio_realtime(audio_source, audio, sr, first_frame_event),\n        )\n        print(\"Stream finished.\")\n    except KeyboardInterrupt:\n        print(\"Stopping stream manually...\")\n    finally:\n        sdk.close()\n        await drain_and_publish()\n        print(\"Disconnecting from room...\")\n        await room.disconnect()\n\n\nawait publish_ditto_stream()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-22T10:23:06.34925Z","iopub.execute_input":"2026-08-22T10:23:06.351415Z","iopub.status.idle":"2026-08-22T10:24:21.76569Z","shell.execute_reply.started":"2026-08-22T10:23:06.351379Z","shell.execute_reply":"2026-08-22T10:24:21.764719Z"}},"outputs":[{"name":"stdout","text":"Initializing StreamSDK (online)...\n","output_type":"stream"}